# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
vendor/
.bundle/

# macOS
.DS_Store
**/.DS_Store

# Local snapshot folders — restore points, not part of the published site
_backup_*/

# Local tooling / notes (contains private research & application notes)
.workbuddy/

# Local working copies — kept on disk but not part of the published static site
paper/
figures/
logo/
blog/
